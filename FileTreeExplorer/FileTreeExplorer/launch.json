{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vite in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMapPathOverrides": {
        "vite:///src/*": "${workspaceFolder}/src/*",
        "/src/*": "${workspaceFolder}/src/*"
      }
    }
  ]
}